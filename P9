-- Function to Create Toggle Button
local function createToggleButton(name, posY, onClick)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.88, 0, 0, 36)
    button.Position = UDim2.new(0.06, 0, 0, posY)
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
    button.Text = name .. " : OFF"
    button.TextColor3 = Color3.fromRGB(180, 180, 180)
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 12
    button.AutoButtonColor = false
    button.Parent = mainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = button

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(60, 60, 80)
    btnStroke.Thickness = 1
    btnStroke.Parent = button

    local state = false
    button.MouseButton1Click:Connect(function()
        state = not state
        if state then
            playSound(SOUND_ID, 1.2)
            button.Text = name .. " : ON"
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
            btnStroke.Color = Color3.fromRGB(200, 100, 255)
        else
            playSound(SOUND_ID, 0.7)
            button.Text = name .. " : OFF"
            button.TextColor3 = Color3.fromRGB(180, 180, 180)
            button.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
            btnStroke.Color = Color3.fromRGB(60, 60, 80)
        end
        onClick(state)
    end)
end

