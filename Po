-- เปิด/ปิด หน้าต่างด้วยปุ่มลอย ⚡
MiniBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- กดปุ่ม เปิด/ปิด Hitbox
ToggleBtn.MouseButton1Click:Connect(function()
    HitboxEnabled = not HitboxEnabled
    if HitboxEnabled then
        ToggleBtn.Text = "สถานะ: เปิดใช้งาน (ON)"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        ToggleBtn.Text = "สถานะ: ปิดอยู่ (OFF)"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

-- รับค่าตัวเลขจากช่องพิมพ์
InputBox:GetPropertyChangedSignal("Text"):Connect(function()
    local num = tonumber(InputBox.Text)
    if num then
        HitboxSize = num
    end
end)

-- ฟังก์ชันปรับขนาด Hitbox
local function ApplyHitbox()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local target = player.Character:FindFirstChild(TargetPart)
            if target then
                if HitboxEnabled then
                    target.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                    target.Transparency = 0.6
                    target.Color = Color3.fromRGB(140, 0, 255)
                    target.Material = Enum.Material.Neon
                    target.CanCollide = false
                else
                    target.Size = Vector3.new(2, 2, 1)
                    target.Transparency = 1
                    target.Material = Enum.Material.Plastic
                end
            end
        end
    end
end

-- ลูปอัปเดตตลอดเวลา
task.spawn(function()
    while task.wait(0.3) do
        pcall(ApplyHitbox)
    end
end)
