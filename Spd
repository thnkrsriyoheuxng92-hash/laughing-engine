-- ========================================================
-- Delta UI Script: ESP + Noclip with UI & Sound Effects
-- ========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local LocalPlayer = Players.LocalPlayer

-- States
local espEnabled = false
local noclipEnabled = false
local espHighlights = {}

-----------------------------------------------------------
-- 1. Sound Setup (ระบบเสียง)
-----------------------------------------------------------
local function playSound(soundId, pitch)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. tostring(soundId)
    sound.Volume = 0.5
    sound.Pitch = pitch or 1
    sound.Parent = SoundService
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

-- ID เสียงสำหรับ กดเปิด / กดปิด
local SOUND_ON = 6895079853   -- เสียงคลิกเปิดแบบอนาคต/ไซไฟ
local SOUND_OFF = 6895079853  -- เสียงเดียวกันแต่ปรับ Pitch ต่ำลง

-----------------------------------------------------------
-- 2. ESP System (ระบบมองทะลุ)
-----------------------------------------------------------
local function applyESP(player)
    if player == LocalPlayer then return end
    
    local function setupHighlight(character)
        if not character then return end
        if character:FindFirstChild("DeltaESP") then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "DeltaESP"
        highlight.FillColor = Color3.fromRGB(255, 0, 127) -- สีชมพูเรืองแสง
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Adornee = character
        highlight.Parent = character
        
        -- ใส่ NameTag บนหัว
        local head = character:WaitForChild("Head", 3)
        if head and not head:FindFirstChild("DeltaNameTag") then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "DeltaNameTag"
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2, 0)
            billboard.AlwaysOnTop = true
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 1, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = player.DisplayName
            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLabel.TextStrokeTransparency = 0
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 12
            nameLabel.Parent = billboard
            
            billboard.Parent = head
        end
    end

    if player.Character then setupHighlight(player.Character) end
    player.CharacterAdded:Connect(setupHighlight)
end

local function removeESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local hl = player.Character:FindFirstChild("DeltaESP")
            if hl then hl:Destroy() end
            if player.Character:FindFirstChild("Head") then
                local tag = player.Character.Head:FindFirstChild("DeltaNameTag")
                if tag then tag:Destroy() end
            end
        end
    end
end

-----------------------------------------------------------
-- 3. Noclip System (ระบบเดินทะลุ)
-----------------------------------------------------------
RunService.Stepped:Connect(function()
    if noclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

