local function updatePlayerName()
    local plist = getOtherPlayers()
    if #plist == 0 then
        nameDisplay.Text = "ไม่มีผู้เล่นอื่น"
    else
        if targetPlayerIndex > #plist then targetPlayerIndex = 1 end
        if targetPlayerIndex < 1 then targetPlayerIndex = #plist end
        nameDisplay.Text = plist[targetPlayerIndex].DisplayName
    end
end

